# Postgres (matches docker-compose default in apps/api/docker-compose.yml)
DATABASE_URL=postgresql://ryr:ryr@localhost:5433/rentyourride

# Auth — use a long random string in production
JWT_SECRET=change-me-in-production

# HTTP
PORT=8080

# Public URL for upload URLs (avatars, listing photos)
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Optional — payouts/payments use mock responses when unset
STRIPE_SECRET_KEY=
# Apple Pay merchant ID (mobile app uses EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER; register in Apple Developer + Stripe)

# Phone verification SMS (AWS End User Messaging / SNS)
AWS_REGION=us-east-2
PHONENUMBER=
# Transactional email (verification, welcome, booking notifications).
# Both are required outside local development; use an SES-verified sender.
AWS_PINPOINT_APP_ID=
AWS_PINPOINT_SENDER_ADDRESS=donotreply+dev@rentyourride.ca
# E.164 origination number for AWS SMS, e.g. +18445550100 (from AWS Pinpoint/SNS console)
# SMS_EXPOSE_CODE=1 — on bedev, return devCode in API when SMS cannot be sent (TestFlight testing)
# AWS credentials use standard SDK env vars (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
# or instance role on EC2.

# Reverse geocoding (server-side only — never put this key in the mobile app)
GOOGLE_GEOCODING_API_KEY=

# Google Sign-In — verify mobile id tokens (Web client ID required; iOS/Android optional)
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=

# Apple Sign-In — defaults to com.rentyourride.ios when unset (iOS bundle / client id)
APPLE_CLIENT_ID=
# Web Services ID (Sign in with Apple on apps/web). Also accepted as token audience.
# APPLE_WEB_CLIENT_ID=com.rentyourride.web
# Optional comma-separated extra audiences
# APPLE_CLIENT_IDS=

# Didit license verification (server-side only — never ship to mobile)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# Optional callback URL for Didit hosted flow redirects (defaults to PUBLIC_BASE_URL/didit/callback)
# DIDIT_CALLBACK_URL=

# NODE_ENV=production disables TypeORM synchronize

# One-time legacy migration audit (scripts/flag-legacy-social-only-users.mjs)
# LEGACY_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/legacy_db
#
# Batch forgot-password for migrated social-only users (send-migration-password-reset.mjs)
# API_BASE_URL=https://bedev.rentyourride.ca
