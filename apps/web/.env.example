# VITE_API_ORIGIN — Nest API origin (no trailing slash, no /v1).
# Testing (fedev / local) → bedev. Production → backend.rentyourride.ca.
# See modes.json and WEB_DEPLOY.md for the full testing vs production matrix.
VITE_API_ORIGIN=https://bedev.rentyourride.ca
#
# Leave VITE_API_ORIGIN unset to use the Vite proxy: browser calls `/api/v1/...`
# forwarded to VITE_DEV_PROXY_TARGET (default https://bedev.rentyourride.ca).
# VITE_DEV_PROXY_TARGET=https://bedev.rentyourride.ca
#
# Stripe publishable key (pk_test on bedev/fedev; pk_live only for production builds)
# Put pk_live_… in .env.production.local (gitignored) — never commit live keys.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_RWUZ7tjfUXgoG6fJb5KFmg6R
#
# Google Sign-In (OAuth Web client ID). Must be listed on Nest as
# GOOGLE_OAUTH_WEB_CLIENT_ID. Add http://localhost:5174, fedev, and app hosts as
# Authorized JavaScript origins in Google Cloud Console.
# Defaults to the same web client id as mobile if unset.
# VITE_GOOGLE_CLIENT_ID=72018389432-1u5ekal6enkntlov1q2rdjn2kij823qr.apps.googleusercontent.com
#
# Sign in with Apple (web Services ID). Also set APPLE_WEB_CLIENT_ID on Nest
# so identity tokens verify. Register Return URL(s) in Apple Developer.
# VITE_APPLE_CLIENT_ID=com.rentyourride.web
# VITE_APPLE_REDIRECT_URI=http://localhost:5174
#
# Crisp live chat (Website ID from Crisp → Settings → Workspace Settings → Setup)
# VITE_CRISP_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Google Maps JavaScript API browser key — powers the price pins on
# /find-your-car. This key is public in the bundle, so restrict it in Google
# Cloud Console to the Maps JavaScript API and to our HTTP referrers
# (http://localhost:5174/*, fedev/festage, app.rentyourride.ca, rentyourride.ca).
# Do NOT reuse the server-side GOOGLE_GEOCODING_API_KEY from the Nest API.
# Without this the search map falls back to an OpenStreetMap embed.
# VITE_GOOGLE_MAPS_API_KEY=
#
# Optional Google Cloud Map ID for custom map styling.
# VITE_GOOGLE_MAPS_ID=
