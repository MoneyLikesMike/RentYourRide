# Production website → Nest production API (never bedev)
VITE_API_ORIGIN=https://backend.rentyourride.ca

# Live Stripe publishable key — put in .env.production.local (gitignored), do not commit pk_live_
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_…

# Live website — "Production Web Client" (not the auto-created / fedev client)
# Add www/.ca/.com/app hosts as Authorized JavaScript origins on this client.
VITE_GOOGLE_CLIENT_ID=524622562399-toivedknrhgcqcnclosv2012ss5bftrv.apps.googleusercontent.com

# Apple web Services ID (Sign in with Apple). Return URLs must be registered in
# Apple Developer → Identifiers → Services IDs → com.rentyourride.web.
VITE_APPLE_CLIENT_ID=com.rentyourride.web
# Leave unset to use window.location.origin (www / app / .com).
# VITE_APPLE_REDIRECT_URI=https://www.rentyourride.ca

# Crisp live chat Website ID
VITE_CRISP_WEBSITE_ID=065277e6-bbc9-4e14-936d-66e377740234

# Google Maps JavaScript API (browser key — restrict by HTTP referrer to the
# production hosts: rentyourride.ca, www, .com, app.rentyourride.ca)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyBXs3NOVpmgc5FLxKUa-OT-GBhTSNnis2c
