{
  "name": "rentyourride",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "start:metro": "bash scripts/update-metro-host.sh && CI=true react-native start",
    "api:deploy:dev": "bash apps/api/scripts/deploy-dev-ec2.sh",
    "stripe:sync-dev": "bash scripts/sync-stripe-dev.sh",
    "phone-sms:sync-dev": "bash scripts/sync-phone-sms-dev.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "api:dev": "npm run start:dev --prefix apps/api",
    "api:build": "npm run build --prefix apps/api",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:submit:ios": "eas submit --platform ios --latest --profile production",
    "ios:archive": "bash scripts/ios-archive-testflight.sh",
    "ios:testflight:upload": "bash scripts/push-testflight.sh"
  },
  "dependencies": {
    "@didit-protocol/sdk-react-native": "^4.0.8",
    "@expo-google-fonts/nunito": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-picker/picker": "^2.11.2",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@stripe/stripe-react-native": "0.45.0",
    "@types/react": "19.0.10",
    "expo": "~53.0.17",
    "expo-apple-authentication": "~7.2.4",
    "expo-av": "~15.1.7",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.4",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-video": "~2.2.2",
    "google-libphonenumber": "^3.2.44",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-confirmation-code-field": "^9.0.0",
    "react-native-country-picker-modal": "^2.0.0",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-maps": "1.20.1",
    "react-native-masked-text": "^1.13.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-phone-number-input": "^2.1.0",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "15.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "^15.1.3",
    "@react-native-community/cli-platform-android": "^15.1.3",
    "@react-native-community/cli-platform-ios": "^15.1.3",
    "@types/react": "^19.1.8",
    "typescript": "~5.8.3"
  },
  "private": true
}
