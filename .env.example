# Copy to .env in the project root (gitignored).
#
# Quick Stripe setup:
#   1. Paste pk_test_… into .env → EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY
#   2. Copy stripe.secret.local.example → stripe.secret.local
#   3. Paste sk_test_… into stripe.secret.local → STRIPE_SECRET_KEY
#   4. npm run stripe:sync-dev
#   5. npm run start:metro

EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mobile — Places autocomplete only (restrict to Places API + com.rentyourride.ios)
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Google Sign-In (defaults to legacy RentYourRide OAuth clients if unset)
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# API server — reverse geocoding (never put this key in the mobile app)
# Set GOOGLE_GEOCODING_API_KEY in apps/api/.env or AWS ryr-dev-secrets
# EXPO_PUBLIC_API_URL=https://bedev.rentyourride.ca
